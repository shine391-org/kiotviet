# ===========================================
# LANO CRM - Environment Configuration
# ===========================================
# Copy this file to .env and customize values
# NEVER commit .env file to git!

# ===========================================
# Application Ports
# ===========================================
APP_PORT=8000
FE_PORT=3000
PMA_PORT=8080
DB_TEST_PORT=3307

# ===========================================
# Database Configuration (REQUIRED)
# ===========================================
# Generate secure passwords: openssl rand -base64 32
DB_ROOT_PASSWORD=CHANGE_ME_root_password_here
DB_PASSWORD=CHANGE_ME_user_password_here
DB_USER=lanocrm_user
DB_DATABASE=lanocrm_dev
DB_TEST_DATABASE=lanocrm_test

# ===========================================
# Resource Limits (adjust for your machine)
# ===========================================
# Low RAM (2-4GB): 512M | Medium (4-8GB): 1G | High (8GB+): 2G
DB_MEMORY_LIMIT=1G

# ===========================================
# Staging Ports (optional)
# ===========================================
# Uncomment if running staging locally
# STAGING_FE_PORT=80
# STAGING_DB_PORT=3308
# STAGING_DB_TEST_PORT=3309
# STAGING_PMA_PORT=8081
