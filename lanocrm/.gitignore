# ========================================
# LANO CRM - Frontend .gitignore
# ========================================
# This file contains React/Node.js specific ignore rules
# Common rules are in the root .gitignore file

# ========================================
# Dependencies
# ========================================
node_modules/
/.pnp
.pnp.js

# ========================================
# Testing
# ========================================
/coverage
coverage-report.json

# ========================================
# Production Builds
# ========================================
/build
/dist
/.next
/out

# ========================================
# Environment Variables
# ========================================
# Note: .env files are already in root .gitignore
# Keeping here for clarity
.env.local
.env.development.local
.env.test.local
.env.production.local

# ========================================
# Logs
# ========================================
# Note: *.log already in root .gitignore
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ========================================
# Cache & Performance
# ========================================
# Note: .cache already in root .gitignore
.vite
.eslintcache
.stylelintcache

# ========================================
# IDE & Editors (Frontend specific)
# ========================================
# Note: General IDE files are in root .gitignore
.history/

# ========================================
# Testing Frameworks
# ========================================
# Playwright
playwright-report/
test-results/
test-output.txt

# Vitest
coverage/

# ========================================
# Misc
# ========================================
*.swp
*~
