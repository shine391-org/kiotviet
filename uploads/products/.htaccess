# Prevent PHP execution
php_flag engine off

# Deny PHP files
<FilesMatch "\.php$">
    Deny from all
</FilesMatch>

# Prevent .htaccess modification
<FilesMatch "^\.ht">
    Deny from all
</FilesMatch>

# Only allow images
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    Allow from all
</FilesMatch>

# Disable directory listing
Options -Indexes