#!/bin/bash

# Docker-only Spark Command Runner
# Usage: ./docker-spark <command>
# Example: ./docker-spark migrate

# Check if Docker container is running
if ! docker ps | grep -q "${DOCKER_CONTAINER:-kiotviet-web-1}"; then
    echo "❌ API container is not running!"
    echo "Please start Docker containers first:"
    echo "  docker-compose up -d"
    exit 1
fi

# Execute spark command in Docker container
docker exec ${DOCKER_CONTAINER:-kiotviet-web-1} php spark "$@"