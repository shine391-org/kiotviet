# ========================================
# LANO CRM - Root .gitignore
# ========================================
# Common ignore rules for the entire project
# Module-specific rules are in their respective .gitignore files

# ========================================
# OS Generated Files
# ========================================
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========================================
# Logs & Debug Files
# ========================================
*.log
*.pid

# ========================================
# IDE & Editor Files
# ========================================
# VSCode
.vscode/
*.code-workspace

# JetBrains (PHPStorm, WebStorm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache

# Vim/Neovim
*.swp
*.swo
*~
.nvim/

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ========================================
# Backup & Temporary Files
# ========================================
*.tmp
*.temp
*.old
*.orig
*.rej
*.bak

# ========================================
# Node.js
# ========================================
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# ========================================
# PHP
# ========================================
composer.phar
**/vendor/
phpunit.xml.dist.backup

# ========================================
# Testing & Coverage
# ========================================
**/coverage/
.nyc_output/
.phpunit.cache/
.phpunit.result.cache
**/test-results/
**/playwright-report/
playwright/.cache/

# ========================================
# Build & Cache
# ========================================
.cache/
.eslintcache
.stylelintcache
.phpintel
*.tsbuildinfo
.turbo/
.parcel-cache/
.vite/
.next/

# ========================================
# Sensitive Configuration
# ========================================
# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.keystore
*.jks

# Configuration with secrets
config/local.*
secrets.*
credentials.*

# Auth tokens (DO NOT COMMIT)
.npmrc
.yarnrc.yml

# Environment files
.env
.env.*
!.env.example

# ========================================
# AI Tools & Agents
# ========================================
.ai/
.factory/
.kilocodemodes
.cursor/
.continue/

# ========================================
# Project Specific
# ========================================
# Screenshots and captures
screenshots/*.png
screenshots/*.jpg
screenshots/*.jpeg

# Docker volumes and data
docker-data/
docker-volumes/

# Database dumps and backups (*.sql allowed)
*.sql.gz
*.dump
db-backups/
backups/

# User uploads
**/uploads/

# Office files
*.xlsx

# ========================================
# Keep directories (ignore contents)
# ========================================
logs/*
!logs/.gitkeep
temp/*
!temp/.gitkeep
tmp/*
!tmp/.gitkeep
uploads/*
!uploads/.gitkeep
