# ========================================
# LANO CRM - Backend .gitignore
# ========================================
# CodeIgniter 4 specific rules (common rules in root .gitignore)

# ========================================
# CodeIgniter 4 Writable Directories
# ========================================
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/tests/*
!writable/tests/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/.db_initialized

# ========================================
# CodeIgniter Development
# ========================================
user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*

# ========================================
# PHP Development
# ========================================
.php-version
php_errors.log

# ========================================
# Build & Distribution
# ========================================
builds/
nbbuild/
nbdist/

# ========================================
# NetBeans IDE
# ========================================
/nbproject/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# ========================================
# Test Results
# ========================================
/results/
