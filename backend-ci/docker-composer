#!/bin/bash

# Docker-only Composer Command Runner
# Usage: ./docker-composer <command>
# Example: ./docker-composer install

# Check if Docker container is running
if ! docker ps | grep -q "meomeo2-api-1"; then
    echo "❌ API container is not running!"
    echo "Please start Docker containers first:"
    echo "  docker-compose up -d"
    exit 1
fi

# Execute composer command in Docker container
docker exec meomeo2-api-1 composer "$@"