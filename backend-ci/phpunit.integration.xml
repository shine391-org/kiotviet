<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
    bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
    backupGlobals="false"
    colors="true"
    columns="max"
    failOnRisky="true"
    failOnWarning="true"
    cacheDirectory="writable/.phpunit.cache"
    timeoutForSmallTests="60"
    timeoutForMediumTests="180"
    timeoutForLargeTests="600">
    
    <!-- Integration tests with MySQL -->
    <testsuites>
        <testsuite name="Integration">
            <directory>./tests/Integration</directory>
        </testsuite>
    </testsuites>
    
    <logging>
        <testdoxHtml outputFile="/tmp/lanocrm-integration-testdox.html"/>
        <junit outputFile="/tmp/lanocrm-integration-logfile.xml"/>
    </logging>
    
    <php>
        <server name="app.baseURL" value="http://localhost:8000/"/>
        
        <!-- CRITICAL: Test database config (uses main database with transaction rollback) -->
        <env name="database.tests.hostname" value="db-test"/>
        <env name="database.tests.port" value="3306"/>
        <env name="database.tests.database" value="lanocrm_test"/>
        <env name="database.tests.username" value="lanocrm_user"/>
        <env name="database.tests.password" value="KP7n4RjcDbedSE2W8GgA"/>
        <env name="database.tests.DBDriver" value="MySQLi"/>
        <env name="database.tests.DBPrefix" value=""/>
        <env name="ENABLE_API_TESTS" value="1"/>
        
        <!-- Performance testing configuration for integration tests -->
        <env name="PERFORMANCE_TESTING_ENABLED" value="1"/>
        <env name="PERFORMANCE_MAX_EXECUTION_TIME" value="10000"/>
        <env name="PERFORMANCE_MAX_MEMORY_MB" value="512"/>
        <env name="PERFORMANCE_MAX_QUERIES" value="100"/>
        <!-- Memory and time limits for integration performance tests -->
        <ini name="memory_limit" value="1G"/>
        <ini name="max_execution_time" value="600"/>
        
        <const name="HOMEPATH" value="./"/>
        <const name="CONFIGPATH" value="./app/Config/"/>
        <const name="PUBLICPATH" value="./public/"/>
    </php>
    
    <!-- Performance testing groups for integration -->
    <groups>
        <include>
            <group>performance</group>
            <group>integration</group>
        </include>
        <exclude>
            <group>slow</group>
        </exclude>
    </groups>
</phpunit>
